<Project>
    <PropertyGroup>
        <ECommonsLocalPath>..\..\ECommons\ECommons\ECommons.csproj</ECommonsLocalPath>
    </PropertyGroup>

    <ItemGroup Condition="
    '$(MSBuildProjectName)' == 'PunishLib' 
    and Exists('$(ECommonsLocalPath)')">
        <PackageReference Remove="ECommons"/>
        <ProjectReference Include="$(ECommonsLocalPath)"/>
    </ItemGroup>
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'ECommons'">
        <Using Include="Lumina.Excel.ExcelPage" Alias="ExcelPage" />
    </ItemGroup>
</Project>