<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EngineSourceRoot Condition="'$(EngineSourceRoot)' == ''">$(MSBuildThisFileDirectory)../.engine</EngineSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Accord.Plugin/LayoutPreferences.cs" Link="LayoutPreferences.cs" />
    <Compile Include="../Accord.Plugin/ConfiguredLayout.cs" Link="ConfiguredLayout.cs" />
    <Compile Include="../Accord.Plugin/CombinedUpdate.cs" Link="CombinedUpdate.cs" />
    <Compile Include="../Contract/*.cs" Link="Contract/%(Filename)%(Extension)" />
    <Reference Include="Dalamud"><HintPath>$(appdata)/XIVLauncher/addon/Hooks/dev/Dalamud.dll</HintPath></Reference>
    <Compile Include="../Accord.Plugin/HotbarLayoutStore.cs" Link="HotbarLayoutStore.cs" />
    <Compile Include="../Accord.Plugin/ManualLayoutPack.cs" Link="ManualLayoutPack.cs" />
    <Compile Include="../Accord.Plugin/ManualFallback.cs" Link="ManualFallback.cs" />
    <EmbeddedResource Include="../Accord.Plugin/manual-layouts.json" LogicalName="Accord.manual-layouts.json" />
    <Compile Include="../Accord.Plugin/HotbarSetup.cs" Link="HotbarSetup.cs" />
    <Compile Include="../Accord.Plugin/PvPHotbars.cs" Link="PvPHotbars.cs" />
    <Compile Include="../Accord.Plugin/SprintHotbars.cs" Link="SprintHotbars.cs" />
    <Compile Include="../Accord.Plugin/HotbarRefreshPolicy.cs" Link="HotbarRefreshPolicy.cs" />
    <Compile Include="../Accord.Plugin/PveLayoutPlan.cs" Link="PveLayoutPlan.cs" />
    <Compile Include="../Accord.Plugin/LiveUpdateState.cs" Link="LiveUpdateState.cs" />
    <Compile Include="../Accord.Plugin/MigrationPreparation.cs" Link="MigrationPreparation.cs" />
    <Compile Include="../Accord.Plugin/AccordSettings.cs" Link="AccordSettings.cs" />
    <Compile Include="../Accord.Plugin/SetupPack.cs" Link="SetupPack.cs" />
    <Compile Include="$(EngineSourceRoot)/WrathCombo/Engine/ForkIdentityMigration.cs" Link="ForkIdentityMigration.cs" />
    <Compile Include="$(EngineSourceRoot)/WrathCombo/Engine/IntentHandoff.cs" Link="IntentHandoff.cs" />
    <Compile Include="$(EngineSourceRoot)/WrathCombo/Engine/PvPRequestState.cs" Link="PvPRequestState.cs" />
    <Compile Include="$(EngineSourceRoot)/WrathCombo/Engine/BurstPolicy.cs" Link="BurstPolicy.cs" />
    <Compile Include="../Accord.Plugin/JobIntents.cs" Link="JobIntents.cs" />
    <Compile Include="../Accord.Plugin/HotbarTransaction.cs" Link="HotbarTransaction.cs" />
    <Compile Include="../Accord.Plugin/Hotbars/ModeActions.cs" Link="ModeActions.cs" />
    <Compile Include="../Accord.Plugin/Hotbars/Models.cs" Link="Models.cs" />
    <Compile Include="../Accord.Plugin/Hotbars/HotbarCleanup.cs" Link="HotbarCleanup.cs" />
    <EmbeddedResource Include="../Accord.Plugin/presets.json" LogicalName="Accord.presets.json" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(appdata)/XIVLauncher/addon/Hooks/dev/Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="../Accord.Plugin/pvp-presets.json" LogicalName="Accord.pvp-presets.json" /></ItemGroup>
  <ItemGroup><Compile Include="../Accord.Plugin/PvPPack.cs" Link="PvPPack.cs" /></ItemGroup>
</Project>
